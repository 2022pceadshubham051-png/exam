generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}
enum Difficulty {
  EASY
  MEDIUM
  HARD
}
enum ReviewStatus {
  AI_GENERATED
  PENDING_REVIEW
  VERIFIED
  PUBLISHED
}
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}
enum AttemptMode {
  EXAM
  PRACTICE
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String? @unique
  passwordHash String
  name String
  displayName String?
  role Role @default(USER)
  targetExam String?
  targetScore Int?
  createdAt DateTime @default(now())
  attempts TestAttempt[]
  lecturePace LecturePaceData?
  age Int?
  onboarded Boolean @default(false)
  inventory Json?
  coinTx CoinTx[]
  rooms RoomMember[]
  sync UserSync?
  refCode String? @unique
  referredBy String?
  streak UserStreak?
  dailyEntries DailyEntry[]
  duelEntries DuelEntry[]
  reports QuestionReport[]
}

model Test {
  id String @id @default(cuid())
  name String
  examName String
  description String?
  durationSec Int
  difficulty Difficulty @default(MEDIUM)
  positiveMarks Float @default(1)
  negativeMarks Float @default(0.25)
  passingPercent Float @default(40)
  globalQuestionSec Int?
  allowSectionBacktrack Boolean @default(false)
  allowSectionSwitch Boolean @default(false)
  shuffleQuestions Boolean @default(false)
  shuffleOptions Boolean @default(false)
  maxTabSwitches Int @default(3)
  requireFullscreen Boolean @default(true)
  showResult Boolean @default(true)
  showExplanations Boolean @default(true)
  leaderboard Boolean @default(true)
  allowPracticeMode Boolean @default(true)
  maxAttempts Int?
  published Boolean @default(false)
  createdAt DateTime @default(now())
  sections Section[]
  attempts TestAttempt[]
  rooms Room[]
}

model Section {
  id String @id @default(cuid())
  testId String
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  name String
  order Int
  durationSec Int
  questionSec Int?
  questions Question[]
  attempts SectionAttempt[]
  @@index([testId, order])
}

model Question {
  id String @id @default(cuid())
  sectionId String?
  section Section? @relation(fields: [sectionId], references: [id])
  text String
  explanation String?
  subject String?
  topic String?
  difficulty Difficulty @default(MEDIUM)
  correctKey String
  timeLimitSec Int?
  status ReviewStatus @default(PENDING_REVIEW)
  createdAt DateTime @default(now())
  options Option[]
  responses QuestionResponse[]
  @@index([subject, topic, difficulty])
  @@index([status])
}

model Option {
  id String @id @default(cuid())
  questionId String
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key String
  text String
  @@unique([questionId, key])
}

model TestAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  testId String
  test Test @relation(fields: [testId], references: [id])
  attemptNo Int
  mode AttemptMode @default(EXAM)
  status AttemptStatus @default(IN_PROGRESS)
  startedAt DateTime @default(now())
  endedAt DateTime?
  currentSectionIdx Int @default(0)
  tabSwitches Int @default(0)
  shuffleSeed Int
  adaptiveQuestionIds Json?
  sections SectionAttempt[]
  responses QuestionResponse[]
  result TestResult?
  @@unique([userId, testId, attemptNo])
  @@index([userId, startedAt])
}

model SectionAttempt {
  id String @id @default(cuid())
  attemptId String
  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId String
  section Section @relation(fields: [sectionId], references: [id])
  startedAt DateTime
  endedAt DateTime?
  locked Boolean @default(false)
  @@unique([attemptId, sectionId])
}

model QuestionResponse {
  id String @id @default(cuid())
  attemptId String
  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question Question @relation(fields: [questionId], references: [id])
  sectionId String
  selectedKey String?
  correctKeySnapshot String?
  isCorrect Boolean?
  status String @default("NOT_VISITED")
  timeSpentMs Int @default(0)
  questionStartedAt DateTime?
  subject String?
  topic String?
  difficulty Difficulty?
  ord Int @default(0)
  snapshot Json?
  updatedAt DateTime @updatedAt
  @@unique([attemptId, questionId])
  @@index([questionId])
}

model TestResult {
  id String @id @default(cuid())
  attemptId String @unique
  attempt TestAttempt @relation(fields: [attemptId], references: [id])
  score Float
  totalMarks Float
  percentage Float
  accuracy Float
  attemptRate Float
  correct Int
  incorrect Int
  unanswered Int
  negativeTotal Float
  timeTakenSec Int
  sectionStats Json
  topicStats Json
  difficultyStats Json
  subjectStats Json?
  rank Int?
  percentile Float?
}

model QuestionAnalytics {
  questionId String @id
  attempts Int @default(0)
  correct Int @default(0)
  avgTimeMs Int @default(0)
}

model AIQuestionGeneration {
  id String @id @default(cuid())
  adminId String
  prompt Json
  rawOutput String
  createdAt DateTime @default(now())
}

model LecturePaceData {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  json String @db.Text
  clientUpdatedAt Float @default(0)
  xp Int @default(0)
  level Int @default(1)
  lectures Int @default(0)
  focusMin Int @default(0)
  reviews Int @default(0)
  activeDays Int @default(0)
  streak Int @default(0)
  bestStreak Int @default(0)
  updatedAt DateTime @updatedAt
  @@index([xp])
}

model CoinTx {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount Int
  reason String
  ref String
  createdAt DateTime @default(now())
  @@unique([userId, reason, ref])
  @@index([userId])
}

// Study rooms: friends share a 6-letter code and compare their best EXAM-mode score on one test.
model Room {
  id String @id @default(cuid())
  code String @unique
  name String
  testId String
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  ownerId String
  createdAt DateTime @default(now())
  members RoomMember[]
}

model RoomMember {
  roomId String
  userId String
  joinedAt DateTime @default(now())
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@index([userId])
}

// Device-independent copy of the student's notebook and preferences (last write wins per key, merged in the app).
model UserSync {
  userId String @id
  data Json
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---- Engagement: streaks, daily challenge, duels, AI doubt solver ----

// Day keys are India-time "YYYY-MM-DD" (see services/coins.dayKey).
model UserStreak {
  userId String @id
  current Int @default(0)
  best Int @default(0)
  lastDay String?
  freezesUsed Int @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// The same 10 questions for every student on a given day.
model DailyChallenge {
  day String @id
  questionIds Json
  createdAt DateTime @default(now())
}

model DailyEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  day String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  correct Int @default(0)
  incorrect Int @default(0)
  score Float @default(0)
  timeSec Int @default(0)
  late Boolean @default(false)
  answers Json?
  @@unique([userId, day])
  @@index([day, score])
}

// 1v1 duel played asynchronously: both students answer the same questions, the server compares results.
model Duel {
  id String @id @default(cuid())
  code String @unique
  creatorId String
  questionIds Json
  durationSec Int
  createdAt DateTime @default(now())
  entries DuelEntry[]
  @@index([creatorId])
}

model DuelEntry {
  duelId String
  userId String
  duel Duel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  correct Int @default(0)
  incorrect Int @default(0)
  score Float @default(0)
  timeSec Int @default(0)
  answers Json?
  @@id([duelId, userId])
  @@index([userId])
}

// Cached AI explanations (same question + language = same answer, so repeat taps cost nothing).
model AiExplanation {
  key String @id
  text String @db.Text
  createdAt DateTime @default(now())
}

// Daily cap on fresh (non-cached) AI calls per student.
model AiUsage {
  userId String
  day String
  count Int @default(0)
  @@id([userId, day])
}

// Students flag a question that looks wrong; admins review the list.
model QuestionReport {
  id String @id @default(cuid())
  questionId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason String
  note String?
  status String @default("OPEN")
  createdAt DateTime @default(now())
  @@unique([userId, questionId])
  @@index([status, createdAt])
}
