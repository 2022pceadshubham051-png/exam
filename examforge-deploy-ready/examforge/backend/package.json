{
  "name": "examforge-backend",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "vitest run",
    "build": "prisma generate && prisma db push --skip-generate",
    "start": "prisma db push && node dist/index.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5",
    "bcrypt": "^5",
    "cors": "^2",
    "express": "^4",
    "express-rate-limit": "^7",
    "helmet": "^7",
    "jsonwebtoken": "^9",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "prisma": "^5",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^1.6.1"
  }
}
